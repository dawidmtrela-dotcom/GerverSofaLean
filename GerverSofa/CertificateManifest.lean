def publishedHmid : RatInterval := ⟨q 12381960467469534857 10000000000000000000000, q 12381960467469534871 10000000000000000000000⟩

/-- Small kernel-checkable chunks of the frozen rational certificate.

The previous one-shot package asked the kernel to normalize the whole executable
replay in one enormous `decide +kernel`.  That is logically sound but can take
hours.  Here the proof path uses the already frozen rational certificate and
checks it in bounded, independent chunks.  The expensive executable replay is
still retained in `ExactReplay.lean` as a diagnostic cross-check, but it is not
recomputed while building the trusted certificate. -/
def piCheck : Bool :=
  RatInterval.strictInsideB machinPi declaredPi

def reducedBoxCheck : Bool :=
  RatInterval.allStrictInsideB k4Image x4 &&
  (match k4Image.drop 2 with
    | phiImage :: thetaImage :: _ =>
        RatInterval.strictInsideB phiImage phiBox &&
        RatInterval.strictInsideB thetaImage thetaBox
    | _ => false)

def fullBoxCheck : Bool :=
  RatInterval.allStrictInsideB k22Image z22

def algebraCheck : Bool :=
  decide (ratio4 < (422 : ℚ) / 1000) &&
  decide (ratio22 < (95 : ℚ) / 10000) &&
  decide (detC4 ≠ 0) &&
  decide (detC22 ≠ 0) &&
  decide (contraction4 < (1 : ℚ) / 1000000000000) &&
  decide (contraction22 < (1 : ℚ) / 10000000000)

def scalarCheck : Bool :=
  RatInterval.subsetB scalar_hmid publishedHmid &&
  decide (scalar_hmid.lo > 0) &&
  decide (scalar_htheta.lo > (41881915317373 : ℚ) / 10000000000000000) &&
  decide (scalar_endpoint_length.lo > (16137632294302516 : ℚ) / 10000000000000000) &&
  decide (scalar_area.lo > (24206448441453775 : ℚ) / 10000000000000000)

def gridCheck : Bool :=
  decide (grid_gu_grid > (3357 : ℚ) / 10000) &&
  decide (grid_gv_grid > (3357 : ℚ) / 10000) &&
  decide (grid_r_bound < (3062 : ℚ) / 1000) &&
  decide (grid_m_bound < (3645 : ℚ) / 1000) &&
  decide (grid_loss < (1647 : ℚ) / 10000) &&
  decide (grid_gu_continuum > (1710 : ℚ) / 10000) &&
  decide (grid_gv_continuum > (1710 : ℚ) / 10000)

/-- All frozen exact-rational certificate checks. -/
def allChecks : Bool :=
  piCheck && reducedBoxCheck && fullBoxCheck && algebraCheck && scalarCheck && gridCheck

set_option maxRecDepth 100000 in
theorem piCheck_eq_true : piCheck = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem reducedBoxCheck_eq_true : reducedBoxCheck = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem fullBoxCheck_eq_true : fullBoxCheck = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem algebraCheck_eq_true : algebraCheck = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem scalarCheck_eq_true : scalarCheck = true := by
  decide +kernel

set_option maxRecDepth 100000 in
theorem gridCheck_eq_true : gridCheck = true := by
  decide +kernel

/-- Kernel-only aggregate theorem assembled from the bounded chunks above. -/
theorem allChecks_eq_true : allChecks = true := by
  simp [allChecks, piCheck_eq_true, reducedBoxCheck_eq_true, fullBoxCheck_eq_true,
    algebraCheck_eq_true, scalarCheck_eq_true, gridCheck_eq_true]

/-- Proposition form convenient for downstream certificate records. -/
def ManifestPass : Prop := allChecks = true

theorem manifestPass : ManifestPass := allChecks_eq_true

end GerverSofa.CertificateManifest
